# ---- Telegram ----
BOT_TOKEN=123456:ABC-your-token-here
# شناسه عددی ادمین‌ها، با کاما جدا شود
ADMIN_IDS=111111111,222222222
# گروه/کانال دریافت رسیدها. اگر خالی باشد به ادمین اول پیام می‌رود
RECEIPTS_CHAT_ID=

# ---- Database ----
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# ---- x-ui / 3x-ui panel ----
# legacy = x-ui 1.x (vaxilu، مسیر /xui/) ، panel = 3x-ui (MHSanaei، مسیر /panel/api/)
# xui3 = 3x-ui نسخه 3 (پنل 3.8.x) که با توکن Bearer کار می‌کند
XUI_VARIANT=legacy
XUI_BASE_URL=https://panel.example.com:2053
# اگر پنل webBasePath دارد اینجا بگذارید، مثلا: /mypath
XUI_WEB_BASE_PATH=
XUI_USERNAME=admin
XUI_PASSWORD=admin
# فقط برای XUI_VARIANT=xui3 — توکن از Settings → Security → API Token
# با scope برابر admin ساخته می‌شود. برای بقیه نسخه‌ها خالی بماند.
XUI_API_TOKEN=
# دامنه/آی‌پی که در لینک کانفیگ برای کاربر استفاده می‌شود
XUI_NODE_HOST=panel.example.com
# آدرس پابلیک اشتراک (اگر subscription پنل فعال است)
XUI_SUB_BASE_URL=
# TLS پنل self-signed است؟
XUI_VERIFY_SSL=false

# ---- پنل دوم VPN (پشتیبان) ----
XUI2_ENABLED=false
XUI2_BASE_URL=https://panel2.example.com:2053
XUI2_WEB_BASE_PATH=
XUI2_USERNAME=admin
XUI2_PASSWORD=admin
XUI2_NODE_HOST=panel2.example.com
XUI2_SUB_BASE_URL=
XUI2_VERIFY_SSL=false

# ---- Subscription server (لینک اشتراک همه پروتکل‌ها) ----
# اگر خالی باشد سرور اشتراک غیرفعال است. آدرس عمومی شامل پورت:
SUB_PUBLIC_URL=
# پورت میزبان که به پورت داخلی ۸۰۸۰ نگاشت می‌شود
SUB_PORT=8080

# ---- Backup ----
# ساعت اجرای بک‌اپ خودکار (0-23)
BACKUP_HOUR=03
# دقیقه اجرای بک‌اپ خودکار (0-59)
BACKUP_MINUTE=00
# تعداد روزهایی که بک‌اپ نگهداری شود
BACKUP_RETENTION_DAYS=30

# ---- Misc ----
TIMEZONE=Asia/Tehran
LOG_LEVEL=INFO
